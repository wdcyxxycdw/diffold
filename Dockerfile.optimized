# 多阶段构建优化版本
FROM nvidia/cuda:12.6.0-runtime-ubuntu22.04 as base

# 设置非交互模式
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Asia/Tokyo

# 安装系统依赖（单独一层，便于缓存）
RUN apt-get update && \
    apt-get install -y \
        python3 python3-venv python3-pip python3-dev \
        git curl wget \
        libxrender1 libxtst6 libxi6 libxrandr2 libxss1 libgconf-2-4 \
        libxcomposite1 libxcursor1 libxdamage1 libfontconfig1 libxfixes3 \
        libasound2 libatk1.0-0 libcairo-gobject2 libgtk-3-0 libgdk-pixbuf2.0-0 \
        build-essential && \
    python3 -m pip install --upgrade pip && \
    python3 -m pip install uv && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

# 临时复制依赖文件用于安装
COPY pyproject.toml README.md ./
RUN mkdir -p diffold rhofold && \
    touch diffold/__init__.py rhofold/__init__.py && \
    python3 -m uv pip install . --system && \
    rm -rf /workspace/*

# 默认入口点（代码通过volume挂载）
ENTRYPOINT ["python3"]
CMD ["--version"] 